@model RentaDeVehiculos.LogicaDeNegocio.DTOs.CreateUserRequest

@{
    ViewData["Title"] = "Crear"; 
}

<h1>Crear</h1>

<h4>Usuario</h4>
<hr />
<form asp-action="Create">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row">

        <div class="form-group col-4">
            <label asp-for="Username" class="control-label">Nombre</label>
            <input asp-for="Username" class="form-control" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        @* <div class="form-group col-3">
            <label asp-for="UserNickname" class="control-label">Nombre</label>
            <input asp-for="UserNickname" class="form-control" />
            <span asp-validation-for="UserNickname" class="text-danger"></span>
        </div> *@

        <div class="form-group col-6">
            <label asp-for="RoleId" class="control-label">Roles</label>
            <select asp-for="RoleId" class="form-control" asp-items="ViewBag.RolId"></select>
            <span asp-validation-for="RoleId" class="text-danger"></span>
        </div>

        <div class="form-group col-3">
            <label asp-for="Password" class="control-label">Password</label>
            <input asp-for="Password" type="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

       @*  <div class="form-group col-3">
            <label asp-for="UserStatus" class="control-label">Estatus</label>
            <select asp-for="UserStatus" class="form-control">
                <option value="True">AACTIVO</option>
                <option value="False">INACTIVO</option>
            </select>
            <span asp-validation-for="UserStatus" class="text-danger"></span>
        </div> *@

        <div class="row">
            <div class="form-group mt-3">
                <input type="submit" value="Crear" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-info">Cancelar</a>
            </div>
        </div>
    </div>
</form>

@section Script {
    @{
        await Html.RenderPartialAsync("_validationscriptspartial");
    }
}
